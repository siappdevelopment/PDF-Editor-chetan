<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_create8"
    android:paddingLeft="10dp"
    android:paddingRight="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:layout_weight="0.5"
                android:orientation="horizontal">

<!--                <LinearLayout-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:orientation="vertical">-->

<!--                    <ImageView-->
<!--                        android:id="@+id/ivQZAppIcon"-->
<!--                        android:layout_width="50dp"-->
<!--                        android:layout_height="50dp"-->
<!--                        android:layout_marginTop="@dimen/_2sdp"-->
<!--                        android:adjustViewBounds="true" />-->

<!--                </LinearLayout>-->
                    <RelativeLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp">

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/qzShimmerIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/white"
                            android:visibility="gone"
                            app:shimmer_auto_start="false"
                            app:shimmer_base_alpha="0.9"
                            app:shimmer_highlight_alpha="1.0">

                            <include layout="@layout/qz_shimmer" />

                        </com.facebook.shimmer.ShimmerFrameLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#00000000"
                            app:cardCornerRadius="@dimen/_10sdp"
                            app:cardElevation="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivQZAppIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/tvQZLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ad_view"
                            android:paddingLeft="@dimen/_4sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:paddingTop="@dimen/_2sdp"
                            android:paddingRight="@dimen/_4sdp"
                            android:paddingBottom="@dimen/_2sdp"
                            android:text="Ad"
                            android:textColor="#ffffff"
                            android:textSize="@dimen/_8sdp"
                            />

                        <TextView
                            android:id="@+id/tvQZAppTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:lines="1"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_11sdp"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQZAppDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:ellipsize="end"
                        android:lines="2"
                        android:fontFamily="@font/roboto_regular"

                        android:maxLines="2"
                        android:textColor="#9B9999"
                        android:textSize="@dimen/_9sdp" />

                </LinearLayout>



            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginVertical="@dimen/_4sdp"
            android:orientation="vertical">



            <TextView
                android:id="@+id/btnQZClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_create7"
                android:gravity="center"
                android:fontFamily="@font/roboto_semibold"
                android:includeFontPadding="false"
                android:padding="@dimen/_9sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp" />


        </LinearLayout>

    </LinearLayout>
</LinearLayout>


