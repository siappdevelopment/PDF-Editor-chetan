<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp">

    <FrameLayout
        android:id="@+id/fMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="4dp"
        app:layout_constraintDimensionRatio="H,1:1.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageViewPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="end|top"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/ic_unselected_box"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:minWidth="@dimen/_20sdp"
            android:paddingLeft="@dimen/_3sdp"
            android:paddingRight="@dimen/_3sdp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/textViewSelection"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="end|top"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/rectangle_primary"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:minWidth="@dimen/_18sdp"
            android:paddingLeft="@dimen/_3sdp"
            android:paddingRight="@dimen/_3sdp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_10sdp"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/icon_color"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imViewOpen"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/_5sdp"
            android:src="@drawable/ic_imview" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
