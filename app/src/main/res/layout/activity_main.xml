<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="OnClickHandler"
            type="com.reader.alldocviewer.pdfeditor.utils.OnClickHandler" />

    </data>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fitsSystemWindows="false"
        tools:context="com.reader.alldocviewer.pdfeditor.ui.activities.main.MainActivity"
        tools:openDrawer="end">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <View
                android:id="@+id/status_bar_scrim"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/coordinator"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/status_bar_scrim">

                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/app_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    app:elevation="0dp">

                    <LinearLayout
                        android:id="@+id/ll_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_scrollFlags="scroll|enterAlways|snap">

                        <ImageView
                            android:id="@+id/iv_menu"
                            android:layout_width="@dimen/_27sdp"
                            android:layout_height="@dimen/_27sdp"
                            android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                            android:src="@drawable/ic_menu" />

                        <ImageView
                            android:id="@+id/ivBack"
                            android:layout_width="@dimen/_27sdp"
                            android:layout_height="@dimen/_27sdp"
                            android:src="@drawable/ic_back"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_title"
                            style="@style/TextStyle.Bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:text="@string/pdf"
                            android:textSize="@dimen/_16sdp" />

                        <TextView
                            android:id="@+id/tv_selection_count"
                            style="@style/TextStyle.SemiBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp"
                            android:visibility="gone"
                            tools:text="0 selected"
                            tools:visibility="visible" />

                        <ImageView
                            android:id="@+id/ivSelectAll"
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_marginEnd="@dimen/_8sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_multi_deselected"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/ll_actions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/fl_search"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:background="@drawable/rounded_ripple_effect_bg"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="@{(v) -> OnClickHandler.onClick(v)}">

                                <ImageView
                                    android:id="@+id/iv_search"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:contentDescription="@string/search"
                                    android:padding="@dimen/_3sdp"
                                    android:src="@drawable/ic_search" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/fl_filter"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:background="@drawable/rounded_ripple_effect_bg"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="@{(v) -> OnClickHandler.onClick(v)}">

                                <ImageView
                                    android:id="@+id/iv_filter"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:padding="@dimen/_3sdp"
                                    android:src="@drawable/ic_filter" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/fl_settings"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:background="@drawable/rounded_ripple_effect_bg"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClick="@{(v) -> OnClickHandler.onClick(v)}">

                                <ImageView
                                    android:id="@+id/iv_settings"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:padding="@dimen/_3sdp"
                                    android:src="@drawable/ic_setting" />
                            </FrameLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/all_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        app:tabIndicatorColor="@color/app_color"
                        app:tabMode="scrollable"
                        app:tabTextAppearance="@style/TabTextStyle" />

                    <View
                        android:id="@+id/view_sep"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/border_color" />

                </com.google.android.material.appbar.AppBarLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                <FrameLayout
                    android:id="@+id/fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_nav_bg"
                android:fitsSystemWindows="false"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingBottom="0dp"
                android:textSize="@dimen/_11sdp"
                app:itemBackground="@drawable/bottom_nav_item_bg"
                app:itemIconSize="@dimen/_19sdp"
                app:itemRippleColor="@android:color/transparent"
                app:itemTextAppearanceActive="@style/TextStyle.SemiBold"
                app:itemTextAppearanceInactive="@style/TextStyle.SemiBold"
                app:itemTextColor="@color/black"
                app:labelVisibilityMode="labeled"
                app:layout_constraintBottom_toTopOf="@+id/banner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:menu="@menu/bottom_menu" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lotti_anim"
                android:layout_width="@dimen/_68sdp"
                android:layout_height="@dimen/_68sdp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
                app:layout_constraintEnd_toEndOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/add_anim" />

            <ImageView
                android:id="@+id/iv_create"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_margin="@dimen/_13sdp"
                android:adjustViewBounds="true"
                android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                android:src="@drawable/ic_add"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/ll_bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12sdp"
                android:visibility="gone"
                android:weightSum="2"
                app:layout_constraintBottom_toTopOf="@+id/banner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/btnRecycleBin"
                    style="@style/TextStyle.Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_button"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:singleLine="true"
                    android:text="@string/option_recycle_bin"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/btnDeleteAll"
                    style="@style/TextStyle.Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rounded_button_blue"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:singleLine="true"
                    android:text="@string/delete"
                    android:textColor="@color/white_"
                    android:textSize="@dimen/_11sdp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="5dp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_container_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        app:shimmer_auto_start="true"
                        app:shimmer_base_color="#ccc">

                        <include layout="@layout/ad_unifiled_small" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <FrameLayout
                        android:id="@+id/flNativeSmallPlaceholder"
                        style="@style/NativeAdsView" />

                </androidx.cardview.widget.CardView>

                <FrameLayout
                    android:id="@+id/flBannerSmallPlaceholder"
                    style="@style/NativeAdsView"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/nav_drawer"
            layout="@layout/layout_nav_drawer"
            android:layout_width="@dimen/_280sdp"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
