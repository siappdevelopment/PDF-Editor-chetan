    <LinearLayout
        android:id="@+id/rlRightSwipeTutorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/llSearch"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:clickable="false"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lavRightSwipe"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginStart="@dimen/_minus30sdp"
            android:layout_marginTop="@dimen/_minus15sdp"
            android:clickable="false"
            android:focusable="false"
            android:rotation="-90"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/right_swipe_animation" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus20sdp"
            android:fontFamily="@font/fig_tree_semibold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Swipe Right"
            android:textColor="@color/white"
            android:textSize="@dimen/_18sdp" />

    </LinearLayout>
</RelativeLayout>
