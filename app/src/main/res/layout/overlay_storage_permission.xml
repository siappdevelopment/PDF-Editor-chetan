<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="1dp"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_14sdp">

        <ImageView
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_52sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pdf" />

        <TextView
            android:id="@+id/tv_permission_title"
            style="@style/TextStyle.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center"
            android:text="@string/storage_permission_title"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/tv_permission_message"
            style="@style/TextStyle.SemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/storage_permission_message"
            android:textColor="@color/grey_color"
            android:textSize="@dimen/_11sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow_access"
            style="@style/TextStyle.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:backgroundTint="@color/app_color"
            android:paddingVertical="@dimen/_8sdp"
            android:text="@string/allow_access"
            android:textColor="@color/white_"
            android:textSize="@dimen/_12sdp"
            app:cornerRadius="@dimen/_14sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_later"
            style="@style/TextStyle.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:backgroundTint="@color/white"
            android:paddingVertical="@dimen/_8sdp"
            android:text="@string/later"
            android:textColor="@color/app_color"
            android:textSize="@dimen/_12sdp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
