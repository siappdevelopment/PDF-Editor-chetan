<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/top_rounded_corner_bg"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Lock Icon -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_55sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_20sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_pdf" />

    <!-- Title -->
    <TextView
        style="@style/TextStyle.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/unlock_file_saving_behavior"
        android:textColor="@color/black"
        android:textSize="@dimen/_14sdp" />

    <!-- Description -->
    <TextView
        style="@style/TextStyle.SemiBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_25sdp"
        android:text="@string/save_the_file_as_a_new_copy"
        android:textColor="@color/grey_color"
        android:textSize="@dimen/_11sdp" />

    <!-- Checkbox: Don't show again -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbDontShowAgain"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:button="@drawable/custom_checkbox" />

        <TextView
            style="@style/TextStyle.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/don_t_show_again"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnOverwrite"
            style="@style/TextStyle.SemiBold"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_action_button"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/shape_bt_negative"
            android:gravity="center"
            android:text="@string/overwrite_file"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnSaveCopy"
            style="@style/TextStyle.SemiBold"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_action_button"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/shape_bt_positive"
            android:gravity="center"
            android:text="@string/save_as_copy"
            android:textColor="@color/white_"
            android:textSize="@dimen/_12sdp" />
    </LinearLayout>

</LinearLayout>
