<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="isDarkTheme"
            type="Boolean" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <RelativeLayout
            android:id="@+id/pdf_viewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_view_pager"
            android:fitsSystemWindows="true">

            <RelativeLayout
                android:id="@+id/rTopView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white">

                <!--   <View
                       android:id="@+id/viewCheck"
                       android:layout_width="match_parent"
                       android:layout_height="@dimen/_1sdp"
                       android:layout_marginTop="@dimen/_48sdp"
                       android:background="@color/view_color" />-->

                <LinearLayout
                    android:id="@+id/llSecTop"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp">

                    <ViewAnimator
                        android:id="@+id/switcher"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true">

                        <RelativeLayout
                            android:id="@+id/topBar0Main"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="@dimen/_10sdp">

                            <ImageView
                                android:id="@+id/ivExit"
                                android:layout_width="@dimen/_27sdp"
                                android:layout_height="@dimen/_27sdp"
                                android:layout_centerVertical="true"
                                android:background="?attr/actionBarItemBackground"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_back" />

                            <ImageView
                                android:id="@+id/ivUndo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_50sdp"
                                android:background="?attr/actionBarItemBackground"
                                android:contentDescription="@null"
                                android:padding="@dimen/_5sdp"
                                android:src="@drawable/ic_undo"
                                android:visibility="gone"
                                app:tint="@color/black" />

                            <ImageView
                                android:id="@+id/ivRedo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_100sdp"
                                android:background="?attr/actionBarItemBackground"
                                android:contentDescription="@null"
                                android:padding="@dimen/_5sdp"
                                android:src="@drawable/ic_redo"
                                android:visibility="gone"
                                app:tint="@color/black" />

                            <TextView
                                android:id="@+id/btnSave"
                                style="@style/TextStyle.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_square_button_primary"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="@dimen/_12sdp"
                                android:paddingVertical="@dimen/_5sdp"
                                android:text="@string/done"
                                android:textColor="@color/white_"
                                android:textSize="@dimen/_12sdp" />
                        </RelativeLayout>
                    </ViewAnimator>
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/allCheckViewer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/frameBottom"
                android:layout_below="@+id/rTopView"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

            <TextView
                android:id="@+id/tv_alert_message"
                style="@style/TextStyle.SemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:background="@drawable/page_num"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/white_"
                android:textSize="@dimen/_11sdp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pageNumber"
                style="@style/TextStyle.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rTopView"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/ovelayround"
                android:gravity="center"
                android:paddingLeft="@dimen/_8sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingRight="@dimen/_8sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:textColor="@color/white_"
                android:textSize="@dimen/_10sdp" />

            <ImageView
                android:id="@+id/ivBrush"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_above="@+id/frameBottom"
                android:layout_centerHorizontal="true"
                android:layout_gravity="end"
                android:layout_margin="@dimen/_22sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:backgroundTint="@color/main_color"
                android:src="@drawable/shape_circle_gray"
                android:visibility="gone"
                app:tint="@color/black" />

            <LinearLayout
                android:id="@+id/llTooltipOne"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/frameBottom"
                android:background="#88000000"
                android:clickable="true"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llTooltipEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/frameBottom"
                android:layout_centerHorizontal="true"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/ic_hint_vector_center"
                android:clickable="true"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTipEdit"
                    style="@style/TextStyle.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:text="@string/tip_editing"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_15sdp">

                    <TextView
                        android:id="@+id/tipEditNext"
                        style="@style/TextStyle.SemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_medium"
                        android:paddingStart="4dp"
                        android:text="@string/got_it"
                        android:textColor="@color/main_color"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/frameBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/llBottomControl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/llSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_16sdp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBrushLable"
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/size"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.reader.alldocviewer.pdfeditor.ui.components.SeekView
                                android:id="@+id/brushSizeSlider"
                                android:layout_width="0dp"
                                android:layout_height="10dp"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:progress="10"
                                app:indicatorRadius="7dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/tvBrushSize"
                                app:layout_constraintStart_toEndOf="@+id/tvBrushLable"
                                app:layout_constraintTop_toTopOf="parent"
                                app:seekBackgroundColor="@color/add_signature_corner"
                                app:seekForegroundColor="#ff3d00"
                                app:seekHeight="4dp" />

                            <TextView
                                android:id="@+id/tvBrushSize"
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvColorSelect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_16sdp"
                            android:layout_marginBottom="@dimen/_12sdp"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_10sdp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/border_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_60sdp"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:id="@+id/rcopyButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imCopy"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_copy" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/highlightButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imHighLite"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_highlight_black" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/underlineButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imUnderLine"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_underline_black" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/strikeOutButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imStrike"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_strike_black" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/inkButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imDrawLine"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_draw_line" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rEraser"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/imEraser"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:src="@drawable/ic_eraser_black" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/signButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imSign"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_sign" />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="5dp">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmer_container_banner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="visible"
                                app:shimmer_auto_start="true"
                                app:shimmer_base_color="#ccc">

                                <include layout="@layout/ad_unifiled_small" />

                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <FrameLayout
                                android:id="@+id/flNativeSmallPlaceholder"
                                style="@style/NativeAdsView" />

                        </androidx.cardview.widget.CardView>

                        <FrameLayout
                            android:id="@+id/flBannerSmallPlaceholder"
                            style="@style/NativeAdsView" />


                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/bView"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_gravity="top"
                    android:background="@color/view_color" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/llTooltipTwo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/frameBottom"
                android:layout_below="@+id/llTooltipOne"
                android:background="#00000000"
                android:clickable="true"
                android:orientation="horizontal"
                android:visibility="gone" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/progressbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_20sdp"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/ProgressbarColor" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</layout>
