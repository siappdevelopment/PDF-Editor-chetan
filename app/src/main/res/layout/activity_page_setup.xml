<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginHorizontal="@dimen/_10sdp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextStyle.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/setup"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="220dp"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grid_card_stroke"
                android:padding="@dimen/_3sdp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/white"
                    app:round="@dimen/_10sdp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@+id/banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvPageDimensions"
            style="@style/TextStyle.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

        <TextView
            android:id="@+id/tvPageSelectionInfo"
            style="@style/TextStyle.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:textColor="@color/grey_color"
            android:textSize="@dimen/_11sdp" />

        <TextView
            style="@style/TextStyle.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/page_size"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutPageSizes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pageSizeOriginal"
                    style="@style/ManagePageOptionText"
                    android:text="@string/original" />

                <TextView
                    android:id="@+id/pageSizeA3"
                    style="@style/ManagePageOptionText"
                    android:text="@string/a3" />

                <TextView
                    android:id="@+id/pageSizeA4"
                    style="@style/ManagePageOptionText"
                    android:text="@string/a4" />

                <TextView
                    android:id="@+id/pageSizeA5"
                    style="@style/ManagePageOptionText"
                    android:text="@string/a5" />

                <TextView
                    android:id="@+id/pageSizeB4"
                    style="@style/ManagePageOptionText"
                    android:text="@string/b4" />

                <TextView
                    android:id="@+id/pageSizeB5"
                    style="@style/ManagePageOptionText"
                    android:text="@string/b5" />

                <TextView
                    android:id="@+id/pageSizeLetter"
                    style="@style/ManagePageOptionText"
                    android:text="@string/letter" />

                <TextView
                    android:id="@+id/pageSizeLegal"
                    style="@style/ManagePageOptionText"
                    android:text="@string/legal" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/TextStyle.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/page_color"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

        <LinearLayout
            android:id="@+id/layoutPageColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/pageColorNone"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkNone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_none"
                    app:tint="@color/black" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pageColorWhite"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_white_rounded_border"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkWhite"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_done_bold"
                    android:visibility="gone"
                    app:tint="@color/black_color" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pageColorGreen"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_green_rounded_border"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkGreen"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_done_bold"
                    android:visibility="gone"
                    app:tint="@color/black_color" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pageColorYellow"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_lightyellow_rounded_border"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkYellow"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_done_bold"
                    android:visibility="gone"
                    app:tint="@color/black_color" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pageColorBlue"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_light_blue_rounded_border"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/checkBlue"
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_done_bold"
                    android:visibility="gone"
                    app:tint="@color/black_color" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_10sdp">

            <TextView
                android:id="@+id/btnApplyToSelected"
                style="@style/TextStyle.Bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_square_button_primary"
                android:gravity="center"
                android:text="@string/apply_to_selected"
                android:textColor="@color/white_"
                android:textSize="@dimen/_13sdp" />

            <ProgressBar
                android:id="@+id/pbDone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_square_button_primary"
                android:indeterminateTint="@color/white"
                android:padding="@dimen/_10sdp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:cardCornerRadius="10dp"
            app:cardElevation="5dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_container_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:shimmer_auto_start="true"
                app:shimmer_base_color="#ccc">

                <include layout="@layout/ad_unifiled_small" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <FrameLayout
                android:id="@+id/flNativeSmallPlaceholder"
                style="@style/NativeAdsView" />

        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/flBannerSmallPlaceholder"
            style="@style/NativeAdsView" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
