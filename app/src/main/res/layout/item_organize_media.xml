<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp">

    <RelativeLayout
        android:id="@+id/mainItemView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,1:1.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_img_icon"
            app:shapeAppearanceOverlay="@style/RoundedCorner10"
            app:strokeColor="@color/view_color"
            app:strokeWidth="1dp" />

        <RelativeLayout
            android:id="@+id/rlRemove"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/_6sdp"
            android:background="@drawable/ic_unchecked_rect"
            android:elevation="1dp">

            <View
                android:layout_width="@dimen/_6sdp"
                android:layout_height="@dimen/_2sdp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_grey_border_4dp"
                android:backgroundTint="@color/black" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlCount"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_18sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="2dp"
            android:background="@drawable/round_bottom_left_disable"
            android:elevation="1dp"
            android:minWidth="@dimen/_18sdp">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/manrope_medium"
                android:paddingHorizontal="@dimen/_4sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sdp" />
        </RelativeLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
