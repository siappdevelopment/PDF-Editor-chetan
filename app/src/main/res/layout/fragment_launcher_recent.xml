<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRecent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".launcher.LauncherRecentFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layout_weight="1"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/_28sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/_18sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:fontFamily="@font/fig_tree_semibold"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="@dimen/_26sdp"
                tools:text="Good Afternoon" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"

                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/fig_tree_medium"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/_13sdp"
                tools:text="Thursday, August 6" />

            <LinearLayout
                android:id="@+id/llDashboardRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Left: Suggested + Recent -->
                <LinearLayout
                    android:id="@+id/llLeftColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_semibold"
                        android:text="@string/suggested_for_now"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_13sdp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSuggestedApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_recent_card"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:padding="@dimen/_8sdp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14sdp"
                        android:fontFamily="@font/fig_tree_semibold"
                        android:text="@string/recent_apps"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_13sdp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecentApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_recent_card"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:padding="@dimen/_8sdp" />
                </LinearLayout>

                <!-- Right: matches left column height -->
                <LinearLayout
                    android:id="@+id/llRightColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvUsageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_semibold"
                        android:text="@string/app_usage_stats"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_13sdp" />

                    <LinearLayout
                        android:id="@+id/llUsageCard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_recent_card"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingTop="@dimen/_8sdp"
                        android:paddingEnd="@dimen/_10sdp"
                        android:paddingBottom="@dimen/_8sdp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fig_tree_medium"
                            android:includeFontPadding="false"
                            android:text="@string/most_used_app"
                            android:textColor="#B3FFFFFF"
                            android:textSize="@dimen/_10sdp" />

                        <!-- Compact most used -->
                        <LinearLayout
                            android:id="@+id/llMostUsedApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMostUsedIcon"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                tools:src="@mipmap/ic_launcher" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvMostUsedName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:ellipsize="end"
                                android:fontFamily="@font/fig_tree_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="#ffffff"
                                android:textSize="@dimen/_10sdp"
                                tools:text="OKEN Scan" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvMostUsedTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:fontFamily="@font/fig_tree_medium"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="#B3FFFFFF"
                                android:textSize="@dimen/_9sdp"
                                tools:text="Screen time : 36m" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:layout_marginBottom="@dimen/_6sdp"
                            android:background="#33FFFFFF" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fig_tree_medium"
                            android:includeFontPadding="false"
                            android:text="@string/top_5_apps"
                            android:textColor="#B3FFFFFF"
                            android:textSize="@dimen/_10sdp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTopUsageApps"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="true"
                            android:overScrollMode="never" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_container_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:shimmer_auto_start="true"
                app:shimmer_base_color="#ccc">

                <include layout="@layout/layout_big_native_ad_load" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <FrameLayout
                android:id="@+id/flNativeSmallPlaceholder"
                style="@style/NativeAdsView" />

        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/flBannerSmallPlaceholder"
            style="@style/NativeAdsView" />
    </LinearLayout>

</LinearLayout>
