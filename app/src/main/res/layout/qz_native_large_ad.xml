<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/mainLayout"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:background="@drawable/bg_create8"
    android:paddingLeft="5dp"
    android:paddingTop="5dp"
    android:paddingRight="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minHeight="50dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
    >

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/qzShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:visibility="gone"
                        app:shimmer_auto_start="false"
                        app:shimmer_base_alpha="0.9"
                        app:shimmer_highlight_alpha="1.0">

                        <include layout="@layout/qz_shimmer" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivQZAppMedia"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                </RelativeLayout>
<!--            <com.google.android.gms.ads.nativead.MediaView-->
<!--                android:id="@+id/ad_media"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="180dp"-->
<!--                android:layout_gravity="center_horizontal" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                        <RelativeLayout
                            android:layout_width="50dp"
                            android:layout_margin="@dimen/_5sdp"
                            android:layout_height="50dp">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/qzShimmerIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/white"
                                android:visibility="gone"
                                app:shimmer_auto_start="false"
                                app:shimmer_base_alpha="0.9"
                                app:shimmer_highlight_alpha="1.0">

                                <include layout="@layout/qz_shimmer" />

                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="#00000000"
                                app:cardCornerRadius="@dimen/_10sdp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivQZAppIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />

                            </androidx.cardview.widget.CardView>

                        </RelativeLayout>
<!--                <ImageView-->
<!--                    android:id="@+id/ad_app_icon"-->
<!--                    android:layout_width="50dp"-->
<!--                    android:layout_height="50dp"-->
<!--                    android:layout_margin="@dimen/_5sdp"-->
<!--                    android:adjustViewBounds="true" />-->


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"

                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/_1sdp"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvQZLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ad_view"
                            android:paddingLeft="@dimen/_4sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:paddingTop="@dimen/_2sdp"
                            android:paddingRight="@dimen/_4sdp"
                            android:paddingBottom="@dimen/_2sdp"
                            android:text="Ad"
                            android:textColor="#ffffff"
                            android:textSize="@dimen/_8sdp"
                            />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvQZAppTitle"                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/black"
                            android:fontFamily="@font/roboto_semibold"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:textSize="@dimen/_11sdp" />


                    </LinearLayout>



                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvQZAppDescription"                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_2sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:lines="2"
                        android:textColor="#9B9999"
                        android:textSize="@dimen/_9sdp" />
                </LinearLayout>
            </LinearLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardElevation="0dp"
                    android:layout_margin="@dimen/_5sdp"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnQZClick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ad_view"
                        android:gravity="center"
                        android:fontFamily="@font/roboto_semibold"
                        android:includeFontPadding="false"
                        android:padding="@dimen/_9sdp"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_12sdp" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>


