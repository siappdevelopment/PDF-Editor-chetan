<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/top_rounded_corner_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextStyle.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginBottom="@dimen/_4sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_16sdp"
        android:text="@string/add_shortcut_to_home_screen"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp" />

    <TextView
        style="@style/TextStyle.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:singleLine="true"

        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/choose_a_style_for_the_shortcut_icon"
        android:textColor="@color/grey_color"
        android:textSize="@dimen/_10sdp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_16sdp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Style 0 (Classic Red) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStyle0"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_6sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <ImageView
                        android:id="@+id/ivStyle0"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:src="@drawable/bg_icon_circle_coral" />

                    <TextView
                        android:id="@+id/tvStyle0"
                        style="@style/TextStyle.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/classic_red"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardStyle1"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_6sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <ImageView
                        android:id="@+id/ivStyle1"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:src="@drawable/bg_icon_circle_purple" />

                    <TextView
                        android:id="@+id/tvStyle1"
                        style="@style/TextStyle.Bold"
                        android:layout_width="wrap_content"
                        android:singleLine="true"

                        android:layout_height="wrap_content"
                        android:text="@string/premium"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardStyle2"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_6sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <ImageView
                        android:id="@+id/ivStyle2"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:src="@drawable/bg_icon_circle_blue" />

                    <TextView
                        android:id="@+id/tvStyle2"
                        style="@style/TextStyle.Bold"
                        android:layout_width="wrap_content"
                        android:singleLine="true"

                        android:layout_height="wrap_content"
                        android:text="@string/sleek_blue"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardStyle3"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_6sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <ImageView
                        android:id="@+id/ivStyle3"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:src="@drawable/bg_icon_circle_orange" />

                    <TextView
                        android:id="@+id/tvStyle3"
                        style="@style/TextStyle.Bold"
                        android:layout_width="wrap_content"
                        android:singleLine="true"

                        android:layout_height="wrap_content"
                        android:text="@string/gradient"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:weightSum="2">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/TextStyle.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="@string/cancel"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/TextStyle.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_button_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/_10sdp"
            android:text="@string/add"
            android:textColor="@color/white_"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>
</LinearLayout>
