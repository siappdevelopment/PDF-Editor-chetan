<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clMainLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cToolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="@dimen/_27sdp"
                    android:layout_height="@dimen/_27sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:src="@drawable/ic_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TextStyle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="@string/arrange_pages"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivBack"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/ivDoneMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:background="@drawable/bg_square_button_primary"
                    android:fontFamily="@font/manrope_semi_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="@string/next"
                    android:textColor="@color/white_"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/border_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cToolbar">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/llCount"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/llCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_4sdp"
                    app:layout_constraintBottom_toTopOf="@+id/rlAction"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/btnPrev"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_left_arrow"
                        app:tint="@color/black" />

                    <TextView
                        android:id="@+id/txtPageCount"
                        style="@style/TextStyle.SemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="@dimen/_50sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />

                    <ImageView
                        android:id="@+id/btnNext"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:src="@drawable/ic_right_arrow"
                        app:tint="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rlAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:id="@+id/vBottom"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/border_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_60sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <LinearLayout
                            android:id="@+id/btnRetake"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_retake_"
                                app:tint="@color/black" />

                            <TextView
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="@string/retake"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnRotate"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_rotate"
                                app:tint="@color/black" />

                            <TextView
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="@string/rotate"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFilter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_color_filter"
                                app:tint="@color/black" />

                            <TextView
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="@string/filter"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCrop"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_crop"
                                app:tint="@color/black" />

                            <TextView
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="@string/crop"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginVertical="5dp"
                        android:orientation="vertical">


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="5dp">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmer_container_banner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="visible"
                                app:shimmer_auto_start="true"
                                app:shimmer_base_color="#ccc">

                                <include layout="@layout/ad_unifiled_small" />

                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <FrameLayout
                                android:id="@+id/flNativeSmallPlaceholder"
                                style="@style/NativeAdsView" />

                        </androidx.cardview.widget.CardView>

                        <FrameLayout
                            android:id="@+id/flBannerSmallPlaceholder"
                            style="@style/NativeAdsView" />


                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clOperation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerEdit"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/llCount2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerFilter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/llCount2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llCount2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/_4sdp"
                app:layout_constraintBottom_toTopOf="@+id/clBottomAction"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/btnPrev2"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_left_arrow"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/txtPageCount2"
                    style="@style/TextStyle.SemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="@dimen/_50sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <ImageView
                    android:id="@+id/btnNext2"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_right_arrow"
                    app:tint="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clBottomAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clFinalAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:animateLayoutChanges="true">

                    <ImageView
                        android:id="@+id/ivClose"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:padding="@dimen/_6sdp"
                        android:src="@drawable/ic_close"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />

                    <TextView
                        android:id="@+id/txtTitleAction"
                        style="@style/TextStyle.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/crop"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ivDone"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:padding="@dimen/_7sdp"
                        android:src="@drawable/ic_tick_black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/llFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/_6sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <RelativeLayout
                                android:id="@+id/btnNone"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginStart="@dimen/_6sdp"
                                android:layout_marginEnd="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/original"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnBw"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginHorizontal="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/bw"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnSepia"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginHorizontal="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/sepia"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnInvert"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginHorizontal="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/invert"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnVintage"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginHorizontal="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/vintage"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnGaussian"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginHorizontal="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp"
                                android:visibility="gone">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/gaussian"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnHighContrast"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginHorizontal="@dimen/_2sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/contrast"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/btnNeutral"
                                android:layout_width="@dimen/_52sdp"
                                android:layout_height="@dimen/_52sdp"
                                android:layout_marginStart="@dimen/_2sdp"
                                android:layout_marginEnd="@dimen/_6sdp"
                                android:background="@drawable/bg_border_selector"
                                android:gravity="top|center_horizontal"
                                android:orientation="vertical"
                                android:padding="2dp">

                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:layout_width="@dimen/_52sdp"
                                    android:layout_height="@dimen/_52sdp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/iv_filter"
                                    app:riv_corner_radius="8dp" />

                                <TextView
                                    style="@style/TextStyle.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="@drawable/bg_filter_selector"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/_1sdp"
                                    android:text="@string/neutral"
                                    android:textColor="@color/white_"
                                    android:textSize="@dimen/_10sdp" />
                            </RelativeLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <CheckBox
                        android:id="@+id/cbApplyAll"
                        style="@style/TextStyle.SemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:button="@drawable/custom_checkbox"
                        android:clickable="false"
                        android:paddingHorizontal="@dimen/_4sdp"
                        android:text="@string/apply_to_all_pages"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llOperation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_60sdp"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <LinearLayout
                            android:id="@+id/btnRotateLeft"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_rotate_left_"
                                app:tint="@color/black" />

                            <TextView
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="@string/left"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnRotateRight"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_rotate_right_"
                                app:tint="@color/black" />

                            <TextView
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="@string/right"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnAutoCrop"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivCrop"
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:src="@drawable/ic_crop_"
                                app:tint="@color/black" />

                            <TextView
                                android:id="@+id/tvCrop"
                                style="@style/TextStyle.SemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="@string/crop"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

