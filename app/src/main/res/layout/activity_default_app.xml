<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/img_default" />

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:fontFamily="@font/fig_tree_semibold"
            android:gravity="center"
            android:text="@string/set_default"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:fontFamily="@font/fig_tree_medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/set_app_as_default_for_your_SMS_conversations_stored_safely_in_one_clean_simple_inbox"
            android:textColor="@color/gray"
            android:textSize="@dimen/_12sdp" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/btnSetDefault"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:shimmer_base_alpha="1"
            app:shimmer_duration="1500"
            app:shimmer_highlight_alpha="0.4">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSetAsDefault"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/fig_tree_medium"
                android:gravity="center"
                android:text="@string/set_as_default"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp" />

        </com.facebook.shimmer.ShimmerFrameLayout>

    </LinearLayout>


</LinearLayout>