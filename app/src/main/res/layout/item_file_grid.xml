<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:layout_marginVertical="@dimen/_5sdp"
        android:background="@drawable/bg_grid_card_stroke"
        android:paddingBottom="@dimen/_2sdp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_image"
            style="@style/GridPreviewCard"
            android:layout_width="0dp"
            android:layout_height="@dimen/_100sdp"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/fl_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_grid_preview">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_grid_preview"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/RoundedImage"
                    app:strokeWidth="0dp"
                    tools:src="@drawable/ic_pdf_type" />

                <ImageView
                    android:id="@+id/iv_file_icon"
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pdf_type" />


                <FrameLayout
                    android:id="@+id/fl_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/rounded_ripple_effect_bg"
                    android:padding="@dimen/_4sdp">

                    <ImageView
                        android:id="@+id/iv_more"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/_6sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_more" />

                </FrameLayout>

                <ImageView
                    android:id="@+id/iv_check"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/_6sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_round_radio_uncheck"
                    android:visibility="gone" />


            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_file_name"
            style="@style/TextStyle.SemiBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_image"
            tools:text="" />

        <TextView
            android:id="@+id/tv_meta"
            style="@style/TextStyle.SemiBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/grey_color"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_file_name"
            tools:text="" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
