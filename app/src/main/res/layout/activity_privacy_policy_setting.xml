<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
  >


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_18sdp"
            android:paddingTop="@dimen/_28sdp"
            android:paddingEnd="@dimen/_18sdp"
            android:paddingBottom="@dimen/_16sdp">

            <TextView
                android:id="@+id/tvPrivacyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_bold"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="@string/privacy_data_title"
                android:textColor="@color/main_color"
                android:textSize="@dimen/_18sdp" />

            <TextView
                android:id="@+id/tvPrivacyIntro1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:fontFamily="@font/fig_tree_medium"
                android:lineSpacingExtra="@dimen/_3sdp"
                android:text="@string/privacy_data_intro_1"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />


            <TextView
                android:id="@+id/tvWhatWeUse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="@font/mulish_bold"
                android:text="@string/privacy_data_what_we_use"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_medium"
                        android:paddingEnd="@dimen/_8sdp"
                        android:text="•"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fig_tree_medium"
                        android:lineSpacingExtra="@dimen/_2sdp"
                        android:text="@string/pdf_amp_file_access_to_find_open_edit_create_save_rename_move_and_manage_pdf_documents_on_your_device"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_medium"
                        android:paddingEnd="@dimen/_8sdp"
                        android:text="•"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fig_tree_medium"
                        android:lineSpacingExtra="@dimen/_2sdp"
                        android:text="@string/manage_external_storage_required_for_document_management_features_that_need_access_to_files_stored_on_your_device"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_medium"
                        android:paddingEnd="@dimen/_8sdp"
                        android:text="•"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fig_tree_medium"
                        android:lineSpacingExtra="@dimen/_2sdp"
                        android:text="@string/app_usage_to_understand_which_screens_and_features_are_used_and_improve_app_performance"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_medium"
                        android:paddingEnd="@dimen/_8sdp"
                        android:text="•"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fig_tree_medium"
                        android:lineSpacingExtra="@dimen/_2sdp"
                        android:text="@string/device_amp_app_information_to_diagnose_errors_improve_stability_and_deliver_notifications_or_app_updates"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fig_tree_medium"
                        android:paddingEnd="@dimen/_8sdp"
                        android:text="•"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/fig_tree_medium"
                        android:lineSpacingExtra="@dimen/_2sdp"
                        android:text="@string/advertising_id_may_be_used_to_display_and_measure_advertisements_where_applicable"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPrivacyFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="@font/fig_tree_medium"
                android:lineSpacingExtra="@dimen/_3sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                tools:text="@string/by_tapping_agree_continue_you_accept_our_terms_and_confirm_you_re_okay_with_this_this_usage_device_and_advertising_data_is_processed_by_the_analytics_and_ad_services_we_use_see_our_privacy_policy_for_details" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/privacy_divider" />

    <LinearLayout
        android:id="@+id/llAgreeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_18sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingEnd="@dimen/_18sdp"
        android:paddingBottom="@dimen/_10sdp">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cbAgreeDataCollection"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:background="@android:color/transparent"
            android:button="@drawable/selector_privacy_checkbox"
            android:checked="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:buttonTint="@null" />

        <TextView
            android:id="@+id/tvAgreeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:fontFamily="@font/fig_tree_medium"
            android:text="@string/privacy_agree_checkbox"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAgreeContinue"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:layout_marginBottom="@dimen/_18sdp"
        android:background="@drawable/bg_privacy_agree_button"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/mulish_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/privacy_agree_continue"
        android:textColor="#ffffff"
        android:textSize="@dimen/_14sdp" />

</LinearLayout>
